---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { locales, localeNames, localeTags, type Locale } from '../i18n/ui';

interface Props {
  current: Locale;
  path: string;
}
const { current, path } = Astro.props;
---

<nav class="lang-switch" aria-label="Language">
  {
    locales.map((l) =>
      l === current ? (
        <span aria-current="true" lang={localeTags[l]}>{localeNames[l]}</span>
      ) : (
        <a href={getRelativeLocaleUrl(l, path)} hreflang={localeTags[l]} lang={localeTags[l]}>
          {localeNames[l]}
        </a>
      ),
    )
  }
</nav>

<style>
  .lang-switch { display: flex; gap: 0.75rem; font-size: 0.9rem; }
  .lang-switch span { color: var(--muted); }
  .lang-switch a { text-decoration: none; }
</style>
