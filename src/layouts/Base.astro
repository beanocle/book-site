---
// 全站基础布局：语言属性、hreflang、导航、语言切换、页脚、全站配色与字体。
import { getRelativeLocaleUrl } from 'astro:i18n';
import { locales, localeTags, t, type Locale, type UiKey } from '../i18n/ui';
import LangSwitch from '../components/LangSwitch.astro';
import { kicker } from '../data/book';

interface Props {
  locale: Locale;
  /** 不含语言前缀的页面路径，如 "" 或 "app"。用于 hreflang、语言切换与导航高亮。 */
  path: string;
  title?: string;
  description?: string;
}

const { locale, path, title, description } = Astro.props;
const siteTitle = t(locale, 'site.title');
const pageTitle = title ? `${title} · ${kicker[locale]}` : `${kicker[locale]} · ${siteTitle}`;
const nav: Array<{ key: UiKey; path: string }> = [
  { key: 'nav.book', path: 'book' },
  { key: 'nav.read', path: 'read' },
  { key: 'nav.app', path: 'app' },
  { key: 'nav.author', path: 'author' },
  { key: 'nav.news', path: 'news' },
  { key: 'nav.support', path: 'support' },
];
const section = path.split('/')[0];
const footer: Array<{ key: UiKey; path: string }> = [
  ...nav,
  { key: 'nav.bonus', path: 'bonus' },
  { key: 'footer.privacy', path: 'privacy' },
];
---

<!doctype html>
<html lang={localeTags[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <meta name="theme-color" content="#1f5a87" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {
      locales.map((l) => (
        <link rel="alternate" hreflang={localeTags[l]} href={new URL(getRelativeLocaleUrl(l, path), Astro.site)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(getRelativeLocaleUrl('ja', path), Astro.site)} />
    <!-- 书名与出版日期定前不索引 -->
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={getRelativeLocaleUrl(locale, '')}>
        <svg viewBox="0 0 32 20" aria-hidden="true"><path d="M0 20 C8 14 12 6 16 2 C20 6 24 14 32 20" fill="none" stroke="currentColor" stroke-width="2.4" /></svg>
        <span>{kicker[locale]}</span>
      </a>
      <nav aria-label="Main">
        {nav.map((item) => (
          <a href={getRelativeLocaleUrl(locale, item.path)} aria-current={section === item.path ? 'page' : undefined}>{t(locale, item.key)}</a>
        ))}
      </nav>
      <LangSwitch current={locale} path={path} />
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <nav aria-label="Footer">
        {footer.map((item) => <a href={getRelativeLocaleUrl(locale, item.path)}>{t(locale, item.key)}</a>)}
      </nav>
      <p class="fine">{t(locale, 'footer.rights')}</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --fg: #1d2630;
    --bg: #fbfaf7;
    --card: #ffffff;
    --muted: #556270;
    --line: #e2ddd3;
    --sea: #1f5a87;
    --brick: #b8442f;
    --accent: #1f5a87;
    --accent-2: #b8442f;
    --maxw: 68rem;
    --serif: 'Yu Mincho', 'YuMincho', 'Hiragino Mincho ProN', 'Noto Serif JP', 'Noto Serif SC', 'Source Han Serif', Georgia, serif;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --fg: #e7e9ec;
      --bg: #11161c;
      --card: #18202a;
      --muted: #9ba7b4;
      --line: #2b3643;
      --sea: #5aa0d6;
      --brick: #e07a5f;
      --accent: #6fb2e3;
      --accent-2: #e8917a;
    }
  }
  * { box-sizing: border-box; }
  html { font-family: system-ui, -apple-system, 'Segoe UI', 'Hiragino Sans', 'Yu Gothic UI', 'Noto Sans JP', 'Noto Sans SC', sans-serif; -webkit-text-size-adjust: 100%; }
  body { margin: 0; color: var(--fg); background: var(--bg); line-height: 1.75; }
  a { color: var(--accent); }
  main { max-width: var(--maxw); margin: 0 auto; padding: 1.5rem 1rem 3rem; }
  h1, h2, h3 { line-height: 1.4; }
  .site-header { position: sticky; top: 0; z-index: 10; backdrop-filter: blur(8px); background: color-mix(in srgb, var(--bg) 88%, transparent);
    border-bottom: 1px solid var(--line); }
  .site-header, .site-footer { padding: 0.75rem max(1rem, calc((100vw - var(--maxw)) / 2 + 1rem)); display: flex; gap: 1.25rem; align-items: center; flex-wrap: wrap; }
  .brand { display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 700; color: var(--fg); text-decoration: none; letter-spacing: 0.06em; font-family: var(--serif); }
  .brand svg { width: 28px; height: 18px; color: var(--brick); }
  .site-header nav { display: flex; gap: 1rem; flex: 1; overflow-x: auto; scrollbar-width: none; white-space: nowrap; }
  .site-header nav a { color: var(--fg); text-decoration: none; font-size: 0.92rem; padding: 0.2rem 0; border-bottom: 2px solid transparent; }
  .site-header nav a:hover { color: var(--accent); }
  .site-header nav a[aria-current='page'] { border-bottom-color: var(--brick); }
  .site-footer { border-top: 1px solid var(--line); color: var(--muted); font-size: 0.85rem; flex-direction: column; align-items: flex-start; gap: 0.5rem; padding-top: 1.5rem; padding-bottom: 2rem; }
  .site-footer nav { display: flex; flex-wrap: wrap; gap: 0.4rem 1.2rem; }
  .site-footer a { color: var(--muted); }
  .fine { margin: 0; }
  @media (max-width: 640px) {
    .site-header { gap: 0.6rem; }
    .site-header nav { order: 3; flex-basis: 100%; }
  }
</style>
